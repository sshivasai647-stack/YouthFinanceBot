# Purpose: Environment template for YouthFinanceBot Flask backend and integrations.
# Existing module dependencies: Existing AI modules consume GROQ_API_KEY and related runtime secrets.

FLASK_ENV=development
PORT=5000
SECRET_KEY=replace-with-strong-random-secret

MONGO_URI=mongodb://localhost:27017/youth_finance_bot
MONGO_DB_NAME=youth_finance_bot

FRONTEND_ORIGIN=http://localhost:3000

JWT_SECRET_KEY=replace-with-strong-jwt-secret
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-password-or-app-password
MAIL_DEFAULT_SENDER=noreply@youthfinancebot.local

HCAPTCHA_SECRET=replace-with-hcaptcha-secret
RATELIMIT_STORAGE_URI=memory://
OTP_EXP_MINUTES=10
RESET_EXP_MINUTES=30
PASSWORD_RESET_BASE_URL=http://localhost:3000/reset-password

GROQ_API_KEY=replace-with-groq-api-key
